{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "27f32064809a4a02879112edc4d0a03c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "HexagonTile (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2045.000244140625,
            "y": 639.0000610351563,
            "width": 226.000244140625,
            "height": 166.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "69e75e9a9df54b3fae6f2158e8327e09"
        },
        {
            "m_Id": "6ef0568546344e69ae442b5e963cda14"
        },
        {
            "m_Id": "1a573df34df74a2e87ce8bb6b9843c52"
        },
        {
            "m_Id": "a5239d5804534e2cba3873b3b44074ef"
        },
        {
            "m_Id": "159a65b0a9bd433597b948487f6f3c06"
        },
        {
            "m_Id": "6e5cacc58c27454292c5c1893849e33f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "HexagonTile",
    "m_FunctionSource": "3bf0fb8fe4b8caa4291394cf44d20f8c",
    "m_FunctionBody": "void HexagonTile_float(\r\n        float2 UV,\r\n        float Scale,\r\n        out float Hexagon, // 六角形\r\n        out float2 HexPos, // 六角形の位置\r\n        out float2 HexUV, // 六角形内のUVを出力\r\n        out float2 HexIndex // 六角形の番号\r\n    )\r\n{\r\n        ///////////////////////////////////////////////////////////////////\r\n        //\r\n        // Original shader from: https://gist.github.com/sakrist/8706749\r\n        //\r\n        // added: hex cell pos, hex cell uv, hex cell index\r\n        //\r\n        ///////////////////////////////////////////////////////////////////\r\n        float2 p = UV * Scale;\r\n        p.x *= 1.15470053838; // x座標を2/√3倍 (六角形の横方向の大きさが√3/2倍になる)\r\n        float isTwo = frac(floor(p.x) / 2.0) * 2.0; // 偶数列目なら1.0\r\n        float isOne = 1.0 - isTwo; // 奇数列目なら1.0\r\n        p.y += isTwo * 0.5; // 偶数列目を0.5ずらす\r\n        float2 rectUV = frac(p); // 四角形タイル\r\n        float2 grid = floor(p); // 四角形グリッド\r\n        p = frac(p) - 0.5;\r\n        float2 s = sign(p); // マス目の右上:(+1, +1) 左上:(-1, +1) 右下:(+1, -1) 左下:(-1, -1)\r\n        p = abs(p); // 上下左右対称にする\r\n        // 六角形タイルとして出力\r\n        Hexagon = abs(max(p.x*1.5 + p.y, p.y*2.0) - 1.0);\r\n        float isInHex = step(p.x*1.5 + p.y, 1.0); // 六角形の内側なら1.0\r\n        float isOutHex = 1.0 - isInHex; // 六角形の外側なら1.0\r\n        // 四角形マスのうち、六角形の外側の部分を補正するために使用する値\r\n        float2 grid2 = float2(0, 0); \r\n        // 偶数列目と奇数列目を同時に加工\r\n        grid2 = lerp(\r\n            float2(s.x, +step(0.0, s.y)), // 奇数列目 (isTwo=0.0の場合はこちらを採用)\r\n            float2(s.x, -step(s.y, 0.0)), // 偶数列目 (isTwo=1.0の場合はこちらを採用)\r\n            isTwo) * isOutHex; // 六角形の外側だけ取り出す\r\n        // 六角形の番号として出力\r\n        HexIndex = grid + grid2; \r\n        // 六角形の座標として出力\r\n        HexPos = HexIndex / Scale;\r\n        // 六角形の内側ならrectUV、外側なら4つの六角形のUVを使う\r\n        HexUV = lerp(rectUV, rectUV - s * float2(1.0, 0.5), isOutHex); \r\n}"
}

